<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homelayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgrounddark"
    tools:context=".HomeFragment">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:layout_margin="0dp"
        app:elevation="0dp">

    <RelativeLayout
        android:id="@+id/fragmenthome_profile_layout"
        android:layout_width="match_parent"
        android:layout_height="60.6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="5dp"
        app:layout_scrollFlags="scroll|enterAlways"
        android:paddingBottom="5dp"
        android:background="@drawable/profilecardbackground"
        android:elevation="6dp"
        android:clipToPadding="false">

        <!-- Profile image -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/home_user_img"
            android:layout_width="49dp"
            android:layout_height="50dp"
            android:src="@drawable/baseline_person_24"
            android:scaleType="centerCrop"
            android:layout_marginBottom="3dp"
            android:background="@color/white"
            app:shapeAppearanceOverlay="@style/roundedImageview"
            />
        <!-- Username -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="-0.8dp"
            android:layout_marginTop="1dp"
            android:layout_toRightOf="@id/home_user_img"
            android:orientation="vertical"
            >
        <TextView
            android:id="@+id/home_user_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/home_user_img"
            android:layout_marginStart="14dp"
            android:textStyle="bold"
            android:layout_marginBottom="-2.3dp"
            android:layout_marginTop="2.1dp"
            android:text="Hello, Jugal"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_medium"
            />

        <TextView
            android:id="@+id/home_user_subtxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/home_user_img"
            android:fontFamily="@font/poppins"
            android:layout_below="@id/home_user_txt"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="2.4dp"
            android:text="Analyse your expenses"
            android:textSize="11.8sp"
            android:textColor="@color/white"
             />
        </LinearLayout>
        <!-- Notification Icon -->
        <ImageView
            android:id="@+id/about_home"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginBottom="1dp"
            android:src="@drawable/about"
            app:tint="@color/white" />

    </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homescrolllayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/innerhomelayout"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="40dp"
            android:layout_marginTop="8dp">

            <!-- Hidden title preserved -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- TITLE -->
                <TextView
                    android:id="@+id/home_expensetitle"
                    android:layout_width="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="8.5dp"
                    android:text="Quick Actions"
                    android:textSize="16sp"
                    android:textColor="@color/white" />

                <!-- ACTION ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">

                    <!-- ADD EXPENSE -->
                    <LinearLayout
                        android:id="@+id/home_additem_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:elevation="@dimen/elevation_homefragment"
                        android:orientation="vertical"

                        android:gravity="center"
                        android:padding="20dp"

                        >

                        <FrameLayout
                            android:layout_width="58dp"
                            android:id="@+id/additemframe"
                            android:layout_height="58dp"
                            android:background="@drawable/itemlayoutbgcircle_green">

                            <ImageView
                                android:id="@+id/additemicon_home"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_add_expense" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/additemtitle_home"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="12dp"
                            android:text="Add Expense"
                            android:textSize="13sp"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/additem_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Update spendings"
                            android:fontFamily="@font/poppins"
                            android:textSize="11sp"
                            android:alpha="0.6"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <!-- VIEW ALL -->
                    <LinearLayout
                        android:id="@+id/home_viewhisaab_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:orientation="vertical"
                        android:elevation="@dimen/elevation_homefragment"
                        android:gravity="center"
                        android:padding="20dp"
                        >

                        <FrameLayout
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:id="@+id/viewframe"
                            android:background="@drawable/itemlayoutbgcircle_blue">

                            <ImageView
                                android:id="@+id/viewhisaab_icon_home"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_view_all" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/viewhisaab_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="12dp"
                            android:text="View All"
                            android:textSize="13sp"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/viewhisaab_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See history"
                            android:textSize="11sp"
                            android:alpha="0.6"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/white" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Analytics Card — spacing & blue icons -->
            <!-- TITLE -->
            <TextView
                android:id="@+id/home_expenseanalyticstitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginBottom="12dp"
                android:text="Spending Analytics"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />

            <!-- CARD -->
            <LinearLayout
                android:id="@+id/analyticsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:elevation="@dimen/elevation_homefragment"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal"
                android:background="@drawable/itemlayoutbg_dark"
                >

                <!-- MONTHLY -->
                <LinearLayout
                    android:id="@+id/home_monthly_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:padding="20dp"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="55dp"
                        android:id="@+id/home_monthly_layout_frame"
                        android:layout_height="55dp"
                        android:background="@drawable/itemlayoutbgcircle_green">

                        <ImageView
                            android:id="@+id/monthlyicon_home"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calendar"
                             />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/monthlytitle_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Monthly"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF" />


                    <TextView
                        android:id="@+id/monthly_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track months"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins"
                        android:alpha="0.6"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- DIVIDER -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:id="@+id/vr1"
                    android:layout_marginBottom="10dp"
                    android:background="#33FFFFFF" />

                <!-- YEARLY -->
                <LinearLayout
                    android:id="@+id/home_yearly_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:padding="20dp"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    >

                    <FrameLayout
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:id="@+id/home_yearly_layout_frame"
                        android:background="@drawable/itemlayoutbgcircle_blue">

                        <ImageView
                            android:id="@+id/yearlyicon_home"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_yearly"
                             />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/yearlytitle_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Yearly"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/yearly_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹98,400"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/yearly_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track years"
                        android:fontFamily="@font/poppins"
                        android:textSize="11sp"
                        android:alpha="0.6"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>


            <com.google.android.gms.ads.AdView
                android:id="@+id/fragmmemt_home_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="-5dp"
                ads:adSize="BANNER"
                ads:adUnitId="@string/bannerid" />

            <!-- TITLE -->
            <TextView
                android:id="@+id/txtTotalBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginBottom="12dp"
                android:text="Balance Enquiry"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />

            <!-- CARD -->
            <LinearLayout
                android:id="@+id/balanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/elevation_homefragment"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/itemlayoutbg_dark"
                android:orientation="vertical"
                >

                <!-- TOP ROW (2 ITEMS) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- HISTORY -->
                    <LinearLayout
                        android:id="@+id/home_incomehistory_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:orientation="vertical"
                        app:cardCornerRadius="10dp"
                        android:gravity="center"
                        app:cardBackgroundColor="#FBFFF7"
                        app:strokeWidth="0.2dp"
                        android:padding="20dp"
                        >

                        <FrameLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:id="@+id/home_incomehistory_layout_frame"
                            android:background="@drawable/itemlayoutbgcircle_teal">

                            <ImageView
                                android:id="@+id/incomehistory_icon_home"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_history"
                                 />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/incomehistory_title_home"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="History"
                            android:fontFamily="@font/poppins_medium"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/incomehistory_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaction log"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins"
                            android:alpha="0.6"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:id="@+id/vr2"
                        android:layout_marginBottom="15dp"
                        android:background="#33FFFFFF" />
                    <LinearLayout
                        android:id="@+id/home_incomeanalytics_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FBFFF7"
                        app:strokeWidth="0.2dp"
                        >

                        <FrameLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:id="@+id/home_incomeanalytics_layout_frame"
                            android:background="@drawable/itemlayoutbgcircle_orange">

                            <ImageView
                                android:id="@+id/incomeanalytics_icon_home"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_analytics"
                                 />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/incomeanalytics_home"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Analytics"
                            android:fontFamily="@font/poppins_medium"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/incomeanalytics_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detailed reports"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins"
                            android:alpha="0.6"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ADD BALANCE BUTTON -->
                <LinearLayout
                    android:id="@+id/home_addbalance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="17dp"
                    android:gravity="center"
                    android:background="@drawable/roundbutton2"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/addbalance"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Add Balance"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>

            <!-- (Unused limit section retained, unchanged) -->
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>