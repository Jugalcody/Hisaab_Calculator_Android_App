<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/display_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgrounddark"
    tools:context="hisaab.store.analyser.display">

    <LinearLayout
        android:id="@+id/display_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbarheight"
        android:background="@color/primarydark"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/display_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/back_height"
            android:layout_gravity="center"
            android:layout_margin="8dp"
            android:minWidth="30dp"
            android:src="@drawable/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:id="@+id/display_toolbar_txt"
            android:padding="5dp"
            android:text="View Hisaab"
            android:textColor="@color/white"
            android:textSize="@dimen/toolbartextsize"
            android:fontFamily="@font/days_one" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/display_toolbar">

        <LinearLayout
            android:id="@+id/display_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/de"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/border4"
                android:hint="@string/display_data"
                android:importantForAutofill="no"
                android:padding="7dp"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:textSize="20sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/display_selection_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/border6"
                android:layout_gravity="center"
                android:gravity="center"
                android:weightSum="4"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"

                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Date"
                    android:textColor="@color/primarylight"
                    android:id="@+id/datetitle_display"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="2dp"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_medium"
                    />
                <Spinner
                    android:id="@+id/display_filter"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"
                    android:popupBackground="@color/white"
                    android:spinnerMode="dropdown" />
                <Spinner
                    android:id="@+id/spin2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:popupBackground="@color/white"
                    android:spinnerMode="dropdown"
                    android:gravity="center_vertical"
                    android:background="@drawable/border6"
                    />



                <Spinner
                    android:id="@+id/spin3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:popupBackground="@color/white"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border6"
                    />

            </LinearLayout>
           <!-- <LinearLayout
                android:id="@+id/filterlayout_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/borderwhite"
                android:paddingStart="15dp"
                android:paddingTop="10dp"
                android:paddingEnd="15dp"
                android:paddingBottom="10dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="20dp"
                    android:id="@+id/filterdatetitle"
                    android:text="Filter Date"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/display_filter2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="10dp"
                    android:background="@color/transparent"
                    android:backgroundTint="#9E6ADD"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

-->


            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchView_display"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                android:visibility="gone"
                android:background="@drawable/searchbar"
                android:iconifiedByDefault="false"
                android:queryHint="Search here..."
                android:padding="8dp" />



            <HorizontalScrollView
                android:id="@+id/presshowhorizon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:fillViewport="false"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="center">

                    <LinearLayout
                        android:id="@+id/headerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/display_showbox_4"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rectangle_box"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Sno"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:visibility="gone"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/display_showbox_1"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rectangle_box"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Item"
                            android:textColor="@color/white"
                            android:visibility="gone"
                            android:textSize="16sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/display_showbox_2"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rectangle_box"
                            android:gravity="center"
                            android:padding="8dp"
                            android:visibility="gone"
                            android:text="Price"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/display_showbox_3"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rectangle_box"
                            android:gravity="center"
                            android:padding="8dp"
                            android:visibility="gone"
                            android:text="Date"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tableContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/headerRow"
                        android:layout_centerHorizontal="true"
                        android:orientation="vertical">
                        <!-- Dynamic rows will be added here -->
                    </LinearLayout>
                </RelativeLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/display_total"
                android:layout_width="@dimen/commonwidth"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="Total money spend : "
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium"
                android:textSize="16sp"
                android:visibility="gone" />



                <RelativeLayout
                    android:layout_width="355dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="center"
                    android:background="@drawable/border6"
                    android:gravity="center"
                    android:id="@+id/carddisplay2"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/doctor_profile_qualititle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:text="Delete Data"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/hideunhide"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/addplus"
                        ads:tint="@color/white" />

                    <LinearLayout
                        android:id="@+id/delete_typelayout_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:layout_below="@id/hideunhide"
                        android:background="@drawable/loginbut3"
                        android:gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="horizontal"
                        android:padding="6dp"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/datetypetitle_display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:text="Select Type"
                            android:textColor="@color/primarylight"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/deletetype_filter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:popupBackground="@color/white"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/delete_datelayout_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/delete_typelayout_display"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/loginbut3"
                        android:padding="5dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <TextView
                            android:id="@+id/deletedate_displaytitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_margin="5dp"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="4"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:text="Select Date"
                            android:textColor="@color/primarylight"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/date_deletedata"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="6"
                            android:background="@drawable/borderwhite"
                            android:drawableLeft="@drawable/baseline_calendar_today_24"
                            android:drawablePadding="9dp"
                            android:drawableTint="@color/black"
                            android:gravity="center|start"
                            android:hint="Date"
                            android:backgroundTint="@color/white"
                            android:minHeight="48dp"
                            android:padding="9dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray2"
                            android:textSize="17sp" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/deletesno_displaylayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/delete_datelayout_display"
                        android:layout_margin="10dp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:background="@drawable/loginbut3"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <TextView
                            android:id="@+id/sno_deletedata_display_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginEnd="5dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="3"
                            android:text="Sno"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:textColor="@color/primarylight"
                            android:textSize="17sp" />
                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="7"
                            android:layout_height="wrap_content"
                            android:id="@+id/displaysno"
                            android:inputType="number"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:layout_margin="10dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:hint="Enter Sno. of row"
                            android:textSize="16sp"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:background="@drawable/border6"
                            android:padding="10dp"
                            />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/deletedisplaypage_but"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/deletesno_displaylayout"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="5dp"
                        android:layout_weight="4"
                        android:background="@drawable/emailborder"
                        android:backgroundTint="#EF3D3D"
                        android:elevation="5dp"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Delete"
                        android:textSize="16sp" />
                </RelativeLayout>


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/nodata_display"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:tint="@color/primarydark"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/nodata" />

            <com.google.android.gms.ads.AdView
                android:id="@+id/adViewdisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                ads:adSize="BANNER"
                ads:adUnitId="@string/bannerid" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/db"
                android:layout_width="@dimen/commonwidth"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="95dp"
                android:background="@drawable/loginbut"
                android:padding="12dp"
                android:text="Search"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/displayPdfdownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="floating button to download pdf"
        android:padding="16dp"
        android:src="@drawable/download" />

</RelativeLayout>