<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analytics_parentlayout"
    android:background="#FEFEFF"
    tools:context=".Analytics_fragment">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/nodata_analytics"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:tint="@color/primarydark"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/nograph" />
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Title -->
        <TextView
            android:id="@+id/txtAnalyticsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spending Insights"
            android:textSize="18sp"
            android:textColor="@color/primarylight"
            android:layout_marginStart="1dp"
            android:fontFamily="@font/days_one"
            android:layout_marginBottom="16dp" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/analytics_innerlayout"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="15dp"
            android:id="@+id/graphtypelayout_analytics"
            android:background="@drawable/spinnerlayoutbg_light"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:weightSum="3"
            android:orientation="horizontal"

            >


            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Select Graph"
                android:layout_marginStart="4dp"
                android:textSize="15sp"
                android:id="@+id/graphtypetitle_analytics"
                android:textColor="@color/primarylight"
                android:fontFamily="@font/poppins_medium"
                />
            <Spinner
                android:id="@+id/spinnerAnalyticsType"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:popupBackground="@color/white"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/border6"
                />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:id="@+id/analyitcs_datelayout"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/border6"
            android:layout_gravity="center|start"
            android:gravity="start|center"
            android:weightSum="3"
            android:orientation="horizontal"

            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Date"
                android:textColor="@color/primarylight"
                android:id="@+id/graphdatetitle_analytics"
                android:layout_marginStart="4dp"
                android:layout_gravity="start|center"
                android:gravity="start|center"
                android:layout_marginEnd="3dp"
                android:layout_marginTop="2dp"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_medium"
                />
            <Spinner
                android:id="@+id/spinnerMonth"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:popupBackground="@color/white"
                android:gravity="center_vertical"
                android:background="@drawable/border6"
                />



            <Spinner
                android:id="@+id/spinnerYear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:popupBackground="@color/white"
                android:layout_height="wrap_content"
                android:background="@drawable/border6"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center|center_vertical"
            android:orientation="horizontal"

            android:gravity="start|center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Full Graph Toggle"
                android:id="@+id/analytics_toggle_title"
                android:textColor="@android:color/black"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchFullGraphexpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="start"
                android:thumbTint="@color/switch_thumb_color"
                android:trackTint="@color/switch_track_color" />

        </LinearLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/monthExpenseChart"
                android:layout_width="match_parent"
                app:cardElevation="2dp"
                android:layout_marginBottom="15dp"
                android:padding="12dp"
                android:layout_height="410dp"/>

        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewanalytics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            ads:adSize="BANNER"
            ads:adUnitId="@string/bannerid" />

        <RelativeLayout
            android:padding="16dp"
            android:layout_width="match_parent"
            android:id="@+id/total_spentlayout_analytics"
            android:layout_marginTop="12dp"
            android:background="@drawable/border2"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/analytics_tspent_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Spent"
                style="@style/analyticscardtext"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                />

            <TextView
                android:id="@+id/analyticstotalspent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 0"
                style="@style/analyticscardtext"
                android:textColor="@android:color/holo_red_light"
                android:textSize="15sp"
                android:layout_alignParentEnd="true" />

        </RelativeLayout>



            <RelativeLayout
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_marginTop="7dp"
                android:background="@drawable/border2"
                android:id="@+id/analytics_treceivelayout"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/analytics_treceive_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Received"
                    style="@style/analyticscardtext"
                    android:textColor="@android:color/black"
                    android:textSize="15sp"
                     />

                <TextView
                    android:id="@+id/analyticstotalreceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 0"
                    style="@style/analyticscardtext"
                    android:textColor="@android:color/holo_green_dark"
                    android:textSize="15sp"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>

        <RelativeLayout
            android:padding="16dp"
            android:layout_width="match_parent"
            android:id="@+id/analytics_tavailablelayout"
            android:layout_marginTop="7dp"
            android:background="@drawable/border2"

            android:layout_marginBottom="10dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/analytics_tremain_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/analyticscardtext"
                android:text="Total Available"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                 />

            <TextView
                android:id="@+id/analyticstotalremain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 0"
                style="@style/analyticscardtext"
                android:textColor="#DAC931"
                android:textSize="15sp"
                android:layout_alignParentEnd="true" />

        </RelativeLayout>
</LinearLayout>
    </LinearLayout>
</ScrollView>
</RelativeLayout>
