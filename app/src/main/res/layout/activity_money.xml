<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgrounddark"
    android:orientation="vertical"
    android:id="@+id/money_container"
    tools:context="hisaab.store.analyser.money">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbarheight"
        android:id="@+id/money_toolbar"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        >

        <ImageView
            android:id="@+id/money_back"
            android:layout_width="30dp"
            android:layout_height="@dimen/back_height"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="5dp"
            android:gravity="start|center"
            android:layout_toRightOf="@id/money_back"
            android:layout_gravity="center"
            android:text="Balance Enquiry"
            android:id="@+id/money_buytitle"
            android:fontFamily="@font/days_one"
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:textSize="@dimen/toolbartextsize"/>

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="24dp"
            android:layout_height="24dp"
            ads:lottie_rawRes="@raw/coin"
            android:gravity="end"
            android:id="@+id/money_coinanim"
            android:layout_gravity="end|center"
            ads:lottie_loop="true"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true"
            ads:lottie_autoPlay="true"
            android:layout_alignParentEnd="true"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10P"
            android:id="@+id/money_point"
            android:layout_toLeftOf="@id/money_coinanim"
            android:layout_centerVertical="true"
            android:textSize="19sp"
            android:textColor="@color/white"
            android:maxLines="1"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="2dp"
            android:layout_toRightOf="@id/money_buytitle"
            android:gravity="end"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_gravity="end|center"

            />
    </RelativeLayout>


    <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:id="@+id/moneylayoutcontent"
        android:orientation="vertical">
        <TextView
            android:id="@+id/mt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:text="@string/total_balance"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_margin="10dp"
            android:textStyle="bold"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical"
            >
        <EditText
            android:id="@+id/me"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_gravity="center"
            android:singleLine="true"
            android:maxLength="17"
            android:background="@drawable/border6"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_medium"
            android:textSize="17.5sp"
            android:textColorHint="@color/gray"
            android:maxLines="1"
            android:hint="Add balance"
            android:paddingTop="30dp"
            android:paddingBottom="30dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:importantForAutofill="no" />
        <EditText
            android:id="@+id/money_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:maxLength="50"
            android:maxLines="1"
            android:layout_marginTop="25dp"
            android:singleLine="true"
            android:background="@drawable/border6"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:textSize="15sp"
            android:textColorHint="@color/gray"
            android:hint="Income source (e.g. Job/Parents)"
            android:paddingStart="15dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="15dp"
            android:importantForAutofill="no" />

        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/mb"
            android:layout_width="wrap_content"
            android:gravity="center"
            android:layout_gravity="end"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:textSize="16sp"
           android:layout_marginEnd="18dp"
            android:padding="13dp"
            android:background="@drawable/loginbut"
            android:textColor="@color/white"
            android:text="@string/add"
            />
        <com.google.android.gms.ads.AdView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/adViewmoney"
            ads:adSize="BANNER"
            android:layout_marginTop="2dp"
            ads:adUnitId="@string/bannerid"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Note"
            android:layout_marginTop="60dp"
            android:layout_marginStart="15dp"
            android:id="@+id/money_note1"
            android:textColor="#E4E4E4"
            android:textSize="16sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:id="@+id/money_note2"
            android:textColor="#E4E4E4"
            android:textSize="14sp"
            android:text="** Add balance is to add the record of your available money, no real money involved."
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:id="@+id/money_note3"
            android:layout_marginBottom="100dp"
            android:layout_marginEnd="10dp"
            android:textColor="#E4E4E4"
            android:textSize="14sp"
            android:text="** Add exact balance to analyse the hisaab correctly."
            />

    </LinearLayout>
</ScrollView>
</LinearLayout>