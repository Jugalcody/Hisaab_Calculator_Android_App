<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context="hisaab.store.analyser.MainActivity">
    <ImageView
        android:id="@+id/about_login"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/baseline_info_24"
        android:textStyle="bold"
        android:layout_gravity="end"
        android:elevation="20dp"
        android:onClick="aboutfunction"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="21dp"
        app:tint="#372755" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white">

            <TextView
                android:id="@+id/hisaab"
                android:layout_width="348dp"
                android:layout_height="175dp"
                android:layout_gravity="center"
                android:layout_marginTop="85dp"
                android:background="@color/white"
                android:fontFamily="casual"
                android:gravity="center"
                android:text="@string/hisaab"
                android:textColor="@color/black"
                android:textSize="49sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:maxLength="10"
                android:layout_marginRight="20dp"
                android:drawableTint="#535353"
                android:background="@drawable/border"
                android:maxLines="1"
                android:hint="Phone Number"
                android:importantForAutofill="no"
                android:minHeight="48dp"
                android:inputType="number"
                android:layout_gravity="center_horizontal"
                android:textSize="18.2sp"
                android:padding="8dp"
                android:drawableLeft="@drawable/baseline_person_24"
                android:drawablePadding="8dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textColorHint="@color/gray" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:textSize="18.2sp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/border"
                android:layout_gravity="center_horizontal"
                android:hint="@string/prompt_password"
                android:drawableLeft="@drawable/baseline_lock_24"
                android:drawablePadding="8dp"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:padding="8dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textColorHint="@color/gray"
           />
            <TextView
                android:id="@+id/forgetpass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Forgot Password?"
                android:gravity="center"
                android:textColor="#4659C3"
                android:minHeight="48dp"
                android:textStyle="bold"
                android:onClick="forgetclick"
                android:textSize="16sp"
                android:layout_marginEnd="25dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="end" />
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:id="@+id/loginprogress"
                android:visibility="gone"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="20dp"
                android:elevation="4dp"
                android:onClick="login"
                android:minHeight="48dp"
                android:layout_marginBottom="60dp"
                android:text="@string/action_sign_in"
                android:padding="8dp"
                android:background="@drawable/loginbut"
                android:textColor="@color/white"
                android:textSize="17sp"
               />

            <TextView
                android:id="@+id/sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:onClick="register"
                android:text="@string/don_t_have_account"
                android:textColor="#4659C3"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"
                android:layout_gravity="center" />

        </LinearLayout>

    </ScrollView>
</LinearLayout>