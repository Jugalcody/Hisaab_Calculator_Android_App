<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:id="@+id/welcomeCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp"
        android:layout_gravity="center"
        android:background="@drawable/cardbackground"
        >

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/welcomeAnimation"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/welcome" />

        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to Hisaab Analyser!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_gravity="center"
            android:textColor="@color/white" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                >
        <TextView
            android:id="@+id/welcomeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thank you for choosing Hisaab Analyser for your expense tracking!\n\nThis app is completely free and secure , all your expense data will be available offline to your device only. It helps you manage your daily expenses with ease, analyse your expenses and income with indepth graph analysis. \n\nAlso you can download your expenses anytime for free!
We hope you enjoy a smooth and powerful tracking experience!."
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="22dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/white" />

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:id="@+id/startprogress"
            android:indeterminateTint="#808ED8"
            android:indeterminate="true"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_margin="10dp"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/welcomeGotIt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:padding="12dp"
            android:background="@drawable/roundbutton" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
