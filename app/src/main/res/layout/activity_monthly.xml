<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/monthly_container"
    android:background="@color/backgrounddark"
    tools:context="hisaab.store.analyser.monthly">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbarheight"
        android:id="@+id/monthly_toolbar"
        android:background="@color/primarydark"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:minWidth="30dp"
            android:layout_height="@dimen/back_height"
            android:layout_margin="8dp"
            android:id="@+id/monthly_back"
            android:layout_gravity="center"
            android:src="@drawable/back"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="5dp"
            android:id="@+id/monthly_toolbar_txt"
            android:gravity="center"
            android:fontFamily="@font/days_one"
            android:text="@string/monthly_analysis"
            android:textColor="@color/white"
            android:textSize="@dimen/toolbartextsize"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Graph Button & Download Icon -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">


                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:layout_marginEnd="15dp"
                    android:layout_centerVertical="true"
                    android:textSize="14sp"
                    android:id="@+id/monthly_reset"
                    android:layout_toLeftOf="@id/monthly_graph"
                    android:backgroundTint="#D85353"
                    android:background="@drawable/loginbut"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Graph"
                    android:id="@+id/monthly_graph"
                    android:textAllCaps="false"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="20dp"
                    android:textSize="16sp"
                    android:background="@drawable/loginbut2"
                    android:padding="12dp"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/download"
                    android:background="@drawable/circlebut"
                    app:tint="@color/white"
                    android:id="@+id/monthlypdf"
                    android:layout_marginStart="10dp"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:padding="14dp"/>
            </RelativeLayout>

            <!-- Balance Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_card"
                android:padding="16dp"
                android:layout_gravity="center_horizontal"
                android:id="@+id/totalbalance_layout"
                android:orientation="vertical"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="13dp">

                <TextView
                    android:id="@+id/monavtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/cardtitletextsize"
                    style="@style/month_year_card_text_style"
                    android:textColor="@color/white"
                    android:text="Total Balance"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewhrcolor"
                    android:layout_marginVertical="5dp"/>

                <TextView
                    android:id="@+id/monav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/white"
                    android:text="---"/>
            </LinearLayout>

            <!-- Income Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_card"
                android:padding="16dp"
                android:layout_gravity="center_horizontal"
                android:id="@+id/totalincome_layout"
                android:orientation="vertical"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/monrectitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/cardtitletextsize"
                    style="@style/month_year_card_text_style"
                    android:textColor="@color/white"
                    android:text="Total Income"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewhrcolor"
                    android:layout_marginVertical="5dp"/>

                <TextView
                    android:id="@+id/monrec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/green"
                    android:text="----"/>
            </LinearLayout>

            <!-- Expenses Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_card"
                android:padding="16dp"
                android:layout_gravity="center_horizontal"
                android:id="@+id/totalspent_layout"
                android:orientation="vertical"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/monstitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/cardtitletextsize"
                    style="@style/month_year_card_text_style"
                    android:textColor="@color/white"
                    android:text="Total Money Spent"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewhrcolor"
                    android:layout_marginVertical="5dp"/>

                <TextView
                    android:id="@+id/mons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/white"
                    android:text="----"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/display_selection_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:layout_margin="20dp"
                android:background="@drawable/border6"
                android:layout_gravity="center"
                android:gravity="center"
                android:weightSum="3"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"

                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Date"
                    android:textColor="@color/primarylight"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"
                    android:id="@+id/monthly_datetitle"
                    android:layout_marginTop="2dp"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_medium"
                    />
                <Spinner
                    android:id="@+id/spinm2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:popupBackground="@color/white"
                    android:gravity="center_vertical"
                    android:background="@drawable/border6"
                    />



                <Spinner
                    android:id="@+id/spinm3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:popupBackground="@color/white"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border6"
                    />

            </LinearLayout>
            <!-- AdView Placement -->
            <com.google.android.gms.ads.AdView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/adViewmonthly"
                android:layout_gravity="bottom"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="10dp"
                ads:adSize="BANNER"
                ads:adUnitId="@string/bannerid"/>

            <!-- Display Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mondb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="15dp"
                android:layout_gravity="center"
                android:layout_marginBottom="64dp"
                android:background="@drawable/loginbut"
                android:padding="12dp"
                android:text="@string/display"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
