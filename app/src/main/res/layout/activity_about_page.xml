<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/aboutparent"
    android:background="@color/white"
    tools:context=".AboutPage">

    <!-- Toolbar (Unchanged) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbarheight"

        android:id="@+id/about_toolbar"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:minWidth="30dp"
            android:layout_height="@dimen/back_height"
            android:layout_margin="8dp"
            android:id="@+id/about_back"
            android:layout_gravity="center"
            android:src="@drawable/back"
            app:tint="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="5dp"
            android:gravity="center"
            android:fontFamily="@font/days_one"
            android:id="@+id/abouttitle"
            android:layout_gravity="center"
            android:text="About"
            android:textColor="@color/black"
            android:textSize="@dimen/toolbartextsize"/>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hisaab Analyser: An Expense Tracker App"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/aboutheader1"
                android:paddingBottom="10dp"
                android:layout_marginTop="0dp"/>

            <ImageView
                android:layout_width="125dp"
                android:layout_height="125dp"
                android:layout_margin="10dp"
                android:background="@color/white"
                android:layout_gravity="center_horizontal"
                android:src="@mipmap/icon2"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hisaab Analyser is an easy-to-use expense tracker app that helps you manage your finances effortlessly. Whether you want to track daily spending, monitor budgets, or analyze expenses, this app provides a simple and effective solution."
                android:textSize="16sp"
                android:id="@+id/aboutcontent1"
                android:padding="11dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/border6"
                android:textColor="@color/black"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="10dp"/>

            <!-- Features Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Key Features:"
                android:textSize="18sp"
                android:id="@+id/aboutcontent2"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingTop="10dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Track your expenses on daily, monthly and yearly basis.\n✅ Get a detailed expense analysis.\n✅ View your expenses for any date, month, or year.\n✅ View graphical expense reports.\n✅ Secure data storage with the option to download daily, monthly or yearly expenses and income history into a PDF.\n✅ Offline mode support.\n✅ Simple and clean UI for easy navigation.\n✅ Receive timely notifications of total monthly expenses.\n✅ Multi-user login support"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/aboutcontent3"

                android:background="@drawable/border6"
                android:padding="11dp"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Limitations:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:id="@+id/aboutcontent4"
                android:textColor="@color/black"
                android:paddingTop="10dp"/>

            <!-- Limitations List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data is stored locally on your device and will remain until the app is installed on your device. Please download your data into PDF before uninstalling the app, as lost data cannot be recovered."
                android:textSize="16sp"
                android:textColor="@color/black"
                android:background="@drawable/border6"
                android:padding="11dp"
                android:layout_marginTop="10dp"
                android:id="@+id/aboutcontent5"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp"/>

            <!-- Button to Navigate to Video Tutorials Page -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/video_tutorial_button"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:background="#2F6793"
                android:text="Watch Video Tutorials"
                android:textColor="@color/white"
                android:drawableEnd="@drawable/baseline_smart_display_24"
                android:textSize="16sp"
                android:elevation="4dp"
                android:padding="13dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:orientation="horizontal"
    >

    <ImageView
        android:id="@+id/instagramimg"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="Instagram"
        android:src="@drawable/instaicon"
        android:textColor="@color/white"
        android:elevation="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"/>
            <ImageView
                android:id="@+id/webpageimg"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="30dp"
                android:src="@drawable/webpageicon"
                android:elevation="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>


</LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
