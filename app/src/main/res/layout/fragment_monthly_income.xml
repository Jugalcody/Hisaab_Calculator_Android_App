<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/monthlyIncomeRootLayout"
    android:layout_width="match_parent"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white"
    tools:context=".MonthlyIncomeFragment">



    <ScrollView
        android:id="@+id/monthlyIncomeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/monthlyIncomeMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/monthlyIncomeHeaderLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:id="@+id/monthlyincome_back"
                    android:layout_width="30dp"
                    android:layout_height="@dimen/back_height"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/back"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/tvMonthlyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Income Analytics"
                    android:textStyle="bold"
                    android:fontFamily="@font/days_one"
                    android:textSize="18sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Spinner Section -->
            <LinearLayout
                android:id="@+id/display_selection_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="15dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/border6"
                android:layout_gravity="center"
                android:gravity="center"
                android:weightSum="2"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSelectDateLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Date"
                    android:textColor="@color/primarylight"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="2dp"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_medium" />

                <Spinner
                    android:id="@+id/monthlyIncomeSpinnerYear"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:popupBackground="@color/white"
                    android:gravity="center_vertical"
                    android:background="@drawable/border6" />
            </LinearLayout>

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/nodata_monthlyanalyticsincome"
                android:layout_width="300dp"
                android:layout_height="280dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:tint="@color/primarydark"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/nodata" />
            <LinearLayout
                android:id="@+id/linegraphlayout_income2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:clipToOutline="true">

                <!-- Full Graph Toggle -->
                <LinearLayout
                    android:id="@+id/fullGraphToggleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="end|center_vertical">

                    <TextView
                        android:id="@+id/tvFullGraphToggleLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Full Graph Toggle"
                        android:textColor="@android:color/black"
                        android:textSize="17sp" />

                    <Switch
                        android:id="@+id/switchFullGraphMonthlyIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />
                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChartMonthlyIncome"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginStart="6dp"
                    android:layout_height="400dp" />

                <com.google.android.gms.ads.AdView
                    android:id="@+id/adViewincome_monthlyad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    ads:adSize="BANNER"
                    ads:adUnitId="@string/bannerid" />
                <RelativeLayout
                    android:id="@+id/totalIncomeCard"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="30dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/border2"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvTotalMonthlyLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Income"
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalMonthlyIncomeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 0"
                        android:textColor="@android:color/holo_green_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
