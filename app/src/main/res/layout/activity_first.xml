<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/first_parent_layout"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/primarylight"
    tools:context="hisaab.store.analyser.first">
    <FrameLayout
        android:id="@+id/containerFrame_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation_home" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/first_view_bg_light"
        android:id="@+id/first_view"
        android:layout_above="@id/bottomNavigation_home" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation_home"
        android:layout_width="match_parent"
        android:layout_height="73dp"
        ads:itemRippleColor="@color/primarylight"
        android:layout_alignParentBottom="true"
        app:itemBackground="@drawable/selector_item_background"
        app:labelVisibilityMode="labeled"
        android:layout_marginEnd="0dp"
        android:layout_gravity="bottom"
        app:itemShapeInsetStart="0dp"
        app:itemShapeInsetTop="0dp"
        app:itemShapeInsetBottom="0dp"
        app:itemShapeInsetEnd="0dp"
        app:itemHorizontalPadding="0dp"
        app:itemPaddingBottom="12dp"
        app:itemPaddingTop="8dp"
        android:background="@color/backgroundlight"
        ads:itemActiveIndicatorStyle="@color/primarylight"
        ads:itemIconSize="25sp"
        ads:itemTextAppearanceActive="@style/BottomNavTextActive_light"
        ads:itemTextAppearanceInactive="@style/BottomNavTextInactive_light"
        app:itemIconTint="@color/bottom_nav_selector_light"
        app:itemHorizontalTranslationEnabled="false"
        app:itemTextColor="@color/bottom_nav_selector_light"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>



